#include "main.h"

void tim6_init(void)
{
    RCC->APB1ENR |= RCC_APB1ENR_TIM6EN;

    TIM6->PSC = 8999;   // 90 MHz / (8999+1) = 10 kHz
    TIM6->ARR = 9;      // 10 ticks = 1 ms

    TIM6->CNT = 0;
    TIM6->CR1 |= TIM_CR1_CEN;
}

void delay_ms(uint32_t delay);

int main(void) {
	SystemClock_Config();
	SystemCoreClockUpdate();
	fpu_enable();

	RCC->AHB1ENR |= 1; //GPIOA ABH bus clock ON
	GPIOA->MODER |= 1 << 10; //GPIOA pin 5 to output

	while (1) {
//		  GPIOA->ODR|=0x20; //0010 0000 set bit 5. p186
		GPIOA->BSRR |= 1<<5;
		delay_ms(1000);
//		  GPIOA->ODR&=~0x20; //0000 0000 clear bit 5. p186
		GPIOA->BSRR |= 1<<21;
		delay_ms(1000);
	}
}

void delay_ms(uint32_t ms)
{
    while (ms--)
    {
        TIM6->SR &= ~TIM_SR_UIF;   // clear flag
        while (!(TIM6->SR & TIM_SR_UIF));  // wait overflow
    }
}
