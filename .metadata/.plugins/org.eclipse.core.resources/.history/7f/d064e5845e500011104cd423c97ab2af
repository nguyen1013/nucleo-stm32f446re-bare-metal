#include "main.h"

void delay_ms(int delay);

int main(void) {
	SystemClock_Config();
	SystemCoreClockUpdate();
	fpu_enable();

	RCC->AHB1ENR |= 1; //GPIOA ABH bus clock ON
	GPIOA->MODER |= 1 << 10; //GPIOA pin 5 to output

	while (1) {
		GPIOA->BSRR |= (1 << 5);  // Set the pin PA5
		delay_ms(20000000); // some random Delay
		GPIOA->BSRR |= ((1 << 5) << 16);  // Reset pin PA5
		delay_ms(20000000);
	}
}

